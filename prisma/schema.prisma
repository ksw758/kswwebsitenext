generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogCategory {
  FREE
  DEVELOP
  GAME
  SPORT
  SHOW
}

model Blog {
  blog_id     Int          @id @default(autoincrement())
  slug        String?      @unique
  title       String       @unique
  description String?
  content     String
  thumbnail   String
  category    BlogCategory
  counts      Int
  hashtags    String[]
  create_at   DateTime     @default(now())
  update_at   DateTime     @default(now()) @updatedAt
}

model User {
  user_id   Int      @id @default(autoincrement())
  username  String
  password  String
  nickname  String
  create_at DateTime @default(now())
}
