generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogCategory {
  FREE
  DEVELOP
  GAME
  SPORT
  SHOW
}

model Blog {
  blog_id   Int          @id @default(autoincrement())
  title     String       @unique
  content   String
  thumbnail String
  category  BlogCategory
  counts    Int
  hashtags  String[]
  create_at DateTime     @default(now())
}

model User {
  user_id   Int      @id @default(autoincrement())
  username  String
  password  String
  nickname  String
  create_at DateTime @default(now())
}
